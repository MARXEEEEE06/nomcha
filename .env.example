# Local defaults (copy to .env and set values for your setup).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nomcha_db
DB_USER=root
DB_PASSWORD=
DB_SSL_CA=
# Aiven Runtime can provide DATABASE_URL through its Connected services integration.
# DB_* values above take precedence when set.
# DATABASE_URL=mysql://user:password@host:port/defaultdb

# Aiven MySQL connection (replace with the values from the Aiven console).
# DB_HOST=your-service.aivencloud.com
# DB_PORT=18143
# DB_NAME=defaultdb
# DB_USER=avnadmin
# DB_PASSWORD=your-aiven-password
# DB_SSL_CA=C:/path/to/ca.pem

ALLOW_TEST_ADMIN_LOGIN=false
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_TOKEN=
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Nomcha
SITE_BASE_URL=http://localhost/nomcha
OTP_PEPPER=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
